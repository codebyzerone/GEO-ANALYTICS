# GEO Analytics environment configuration
# Copy this file to .env and adjust as needed. No secrets are required for local dev.

APP_NAME=GEO Analytics API
APP_VERSION=1.0.0

# CORS allowlist (comma-separated). Defaults to localhost for dev.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache TTL in seconds (default 10 minutes)
CACHE_TTL_SECONDS=600

# SQLite database path for history persistence
DATABASE_URL=sqlite:///./geo_analytics.db

# Ollama host (used by llm_service). Default local Ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama model name. llm_service reads OLLAMA_MODEL (default gemma3:1b) — no hardcoded model paths in code.
OLLAMA_MODEL=gemma3:1b